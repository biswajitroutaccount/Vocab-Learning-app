/* ═══════════════════════════════════════════════════
   STATE
═══════════════════════════════════════════════════ */
let topic = "all";
let pool  = [];
let seen  = new Set();
let cur   = null;
let mode  = "learn"; // "learn" | "quiz"
let quizType = ""; // "spell" | "define" | "use"
let session = {ok:0, err:0, streak:0};
let recognition = null;
let synth = window.speechSynthesis;
let listening = false;
let speaking  = false;

const $ = id => document.getElementById(id);

/* ── build pool ── */
function buildPool() {
  pool = topic === "all" ? [...WORDS] : WORDS.filter(w => w.t === topic);
  seen.clear();
}
buildPool();

/* ── pick next word ── */
function nextWord() {
  const unseen = pool.filter(w => !seen.has(w.w));
  if (!unseen.length) { seen.clear(); }
  const fresh = pool.filter(w => !seen.has(w.w));
  const idx = Math.floor(Math.random() * fresh.length);
  return fresh[idx];
}

/* ═══════════════════════════════════════════════════
   STATUS / LOG
═══════════════════════════════════════════════════ */
function setStatus(state, txt) {
  $("sdot").className = "sdot" + (state ? " "+state : "");
  $("stxt").textContent = txt;
}

function addLog(role, txt) {
  const log = $("log");
  log.style.display = "flex";
  const d = document.createElement("div");
  d.className = "lmsg " + (role === "ag" ? "ag" : "us");
  d.innerHTML = `<b>${role === "ag" ? "Tutor" : "You"}:</b> ${txt}`;
  log.appendChild(d);
  log.scrollTop = log.scrollHeight;
}

/* ═══════════════════════════════════════════════════
   SPEECH SYNTHESIS
═══════════════════════════════════════════════════ */
function speak(txt, onDone) {
  if (!synth) { onDone && onDone(); return; }
  synth.cancel();
  const u = new SpeechSynthesisUtterance(txt);
  u.rate = 0.93; u.pitch = 1.02;
  speaking = true;
  setStatus("speak", "Speaking…");
  u.onend = u.onerror = () => {
    speaking = false;
    if (mode !== "quiz") setStatus("", 'Say a command or tap "Ask something"');
    else setStatus("", "Listening for your quiz answer…");
    $("btnmic").disabled = false;
    onDone && onDone();
  };
  synth.speak(u);
}

/* ═══════════════════════════════════════════════════
   WORD DISPLAY
═══════════════════════════════════════════════════ */
function showWord(w) {
  cur = w;
  seen.add(w.w);
  mode = "learn";
  $("quiz-area").style.display = "none";
  $("card").style.display = "flex";
  $("card").className = "card";

  $("cword").textContent = w.w; $("cword").className = "cword";
  $("cphon").textContent = w.ph;
  $("cpos").textContent  = w.pos; $("cpos").style.display = "inline-block";
  $("cdef").textContent  = w.def;
  $("cex").textContent   = "\""+w.ex+"\""; $("cex").style.display = "block";
  $("csyns").textContent = "Synonyms: "+w.syns; $("csyns").style.display = "block";
  $("cmnem").textContent = "💡 "+w.mem; $("cmnem").style.display = "block";

  $("btnspk").style.display = "";
  $("hints").style.display = "flex";
  updateScore();
  setStatus("", 'Say a command or tap "Ask something"');
  $("btnmic").disabled = false;

  const intro = `Your word is: ${w.w}. ${w.ph}. ${w.pos}. ${w.def}. Here's an example: ${w.ex}. Memory tip: ${w.mem}`;
  addLog("ag", `<b>${w.w}</b> — ${w.def}`);
  speak(intro);
}

function loadNewWord() {
  if (!cur) {
    $("cword").textContent = "…";
    $("cword").className = "cword shim";
  }
  $("log").innerHTML = ""; $("log").style.display = "none";
  $("quiz-area").style.display = "none";
  $("card").style.display = "flex";
  $("card").className = "card";
  $("hints").style.display = "none";
  $("btnnew").disabled = true;
  $("btnmic").disabled = true;
  setStatus("think", "Picking a word…");
  setTimeout(() => { showWord(nextWord()); $("btnnew").disabled = false; }, 300);
}

/* ═══════════════════════════════════════════════════
   QUIZ MODE
═══════════════════════════════════════════════════ */
const QUIZ_TYPES = [
  { type:"spell",  prompt: w => `How do you spell "${w.w}"? Type or say it letter by letter.` },
  { type:"define", prompt: w => `I'll give you the definition — what's the word?\n"${w.def}"` },
  { type:"use",    prompt: w => `Use the word "${w.w}" in a sentence.` }
];

function startQuiz() {
  if (!cur) { speak("Please load a word first."); return; }
  mode = "quiz";
  const qt = QUIZ_TYPES[Math.floor(Math.random() * QUIZ_TYPES.length)];
  quizType = qt.type;
  const prompt = qt.prompt(cur);

  $("card").style.display = "none";
  $("quiz-area").style.display = "block";
  $("qprompt").textContent = prompt;
  $("qinput").value = "";
  $("qfb").textContent = "";
  $("qfb").className = "quiz-feedback";
  $("quiz-card").className = "card";
  setStatus("", "Answer the question — type or speak");
  addLog("ag", prompt);
  speak(prompt, () => { $("qinput").focus(); });
}

function checkQuizAnswer(ans) {
  if (!ans.trim()) return;
  ans = ans.trim().toLowerCase();
  addLog("us", ans);
  let correct = false;

  if (quizType === "spell") {
    const cleaned = ans.replace(/[\s\.\-]/g,"");
    correct = cleaned === cur.w.toLowerCase();
  } else if (quizType === "define") {
    correct = ans.includes(cur.w.toLowerCase()) ||
              cur.syns.toLowerCase().split(",").some(s => ans.includes(s.trim()));
  } else if (quizType === "use") {
    correct = ans.includes(cur.w.toLowerCase()) ||
              cur.syns.toLowerCase().split(",").some(s => ans.includes(s.trim()));
  }

  if (correct) {
    session.ok++; session.streak++;
    $("quiz-card").className = "card flash-ok";
    $("qfb").textContent = "✓ Correct! Well done.";
    $("qfb").className = "quiz-feedback ok";
    addLog("ag", `✓ Correct! The word is "${cur.w}".`);
    speak(`Correct! Great job! The answer is ${cur.w}.`, () => {
      setTimeout(() => { mode = "learn"; $("card").style.display="flex"; $("quiz-area").style.display="none"; updateScore(); }, 800);
    });
  } else {
    session.err++; session.streak = 0;
    $("quiz-card").className = "card flash-err";
    const hint = `Not quite. ${quizType === "spell" ? "The word is spelled: " + cur.w.split("").join("-") + "." : "The word is " + cur.w + ". " + cur.def}`;
    $("qfb").textContent = "✗ " + hint;
    $("qfb").className = "quiz-feedback err";
    addLog("ag", hint);
    speak(hint, () => {
      setTimeout(() => { mode = "learn"; $("card").style.display="flex"; $("quiz-area").style.display="none"; updateScore(); }, 1200);
    });
  }
  updateScore();
}

/* ═══════════════════════════════════════════════════
   COMMAND PARSER — no AI, pure JS
═══════════════════════════════════════════════════ */
function handleCommand(raw) {
  if (!raw.trim()) return;
  const t = raw.toLowerCase().trim();
  addLog("us", raw);

  // quiz answer mode
  if (mode === "quiz") {
    $("qinput").value = raw;
    checkQuizAnswer(raw);
    return;
  }

  if (!cur) {
    if (/new|start|word|begin/.test(t)) { loadNewWord(); return; }
    speak("Say 'new word' to get started!"); return;
  }

  // commands
  if (/next|new word|skip|another/.test(t))          { loadNewWord(); return; }
  if (/quiz|test|challenge/.test(t))                  { startQuiz(); return; }
  if (/repeat|again|say it again|hear again/.test(t)) {
    speak(`${cur.w}. ${cur.def}. ${cur.ex}.`);
    addLog("ag", `Repeating: ${cur.w}`); return;
  }
  if (/example|sentence|use it/.test(t)) {
    const r = `Here's an example: ${cur.ex}`;
    addLog("ag", r); speak(r); return;
  }
  if (/synonym|related|similar|also called/.test(t)) {
    const r = `Synonyms for ${cur.w}: ${cur.syns}.`;
    addLog("ag", r); speak(r); return;
  }
  if (/memory|tip|mnemonic|remember|trick/.test(t)) {
    const r = `Memory tip: ${cur.mem}`;
    addLog("ag", r); speak(r); return;
  }
  if (/mean|definition|define|what is/.test(t)) {
    const r = `${cur.w} means: ${cur.def}`;
    addLog("ag", r); speak(r); return;
  }
  if (/spell|letters|spelling/.test(t)) {
    const r = `${cur.w} is spelled: ${cur.w.split("").join(", ")}.`;
    addLog("ag", r); speak(r); return;
  }
  if (/pronun|say it|phonetic|how.*say/.test(t)) {
    const r = `${cur.w} is pronounced: ${cur.ph}. ${cur.w}.`;
    addLog("ag", r); speak(r); return;
  }
  if (/part.*speech|what.*type|noun|verb|adj/.test(t)) {
    const r = `${cur.w} is a ${cur.pos}.`;
    addLog("ag", r); speak(r); return;
  }
  if (/score|how.*doing|progress/.test(t)) {
    const tot = session.ok+session.err;
    const pct = tot>0 ? Math.round(session.ok/tot*100) : 0;
    const r = `You've answered ${session.ok} correctly out of ${tot} total. That's ${pct}%. Current streak: ${session.streak}.`;
    addLog("ag", r); speak(r); return;
  }
  if (/help|command|what can|options/.test(t)) {
    $("overlay").classList.add("open"); return;
  }

  // fallback — echo the word info
  const r = `I'm not sure about that. The current word is ${cur.w}: ${cur.def}. Try saying 'quiz me', 'example', or 'next word'.`;
  addLog("ag", r); speak(r);
}

/* ═══════════════════════════════════════════════════
   SCORE
═══════════════════════════════════════════════════ */
function updateScore() {
  const tot = session.ok + session.err;
  const pct = tot > 0 ? Math.round(session.ok / tot * 100) : 0;
  $("cok").textContent  = `✓ ${session.ok} correct`;
  $("cerr").textContent = `✗ ${session.err} wrong`;
  $("cstr").textContent = `🔥 ${session.streak} streak`;
  $("ctot").textContent = `📚 ${seen.size} seen`;
  $("pgfil").style.width   = pct + "%";
  $("pglbl").textContent   = `${pct}% correct`;
}

/* ═══════════════════════════════════════════════════
   SPEECH RECOGNITION
═══════════════════════════════════════════════════ */
function initSR() {
  const SR = window.SpeechRecognition || window.webkitSpeechRecognition;
  if (!SR) { $("nospeech").style.display = "block"; $("btnmic").style.display = "none"; return; }
  recognition = new SR();
  recognition.lang = "en-US";
  recognition.interimResults  = false;
  recognition.maxAlternatives = 1;
  recognition.continuous      = false;

  recognition.onstart = () => {
    listening = true;
    setStatus("listen", "Listening… speak now");
    $("btnmic").innerHTML = '<i class="ti ti-microphone-off"></i> Stop';
  };
  recognition.onresult = e => {
    const txt = e.results[0][0].transcript;
    listening = false;
    $("btnmic").innerHTML = '<i class="ti ti-microphone"></i> Ask something';
    handleCommand(txt);
  };
  recognition.onerror = recognition.onend = () => {
    if (!listening) return;
    listening = false;
    $("btnmic").innerHTML = '<i class="ti ti-microphone"></i> Ask something';
    setStatus("", "Mic stopped. Try again.");
    $("btnmic").disabled = false;
  };
}

/* ═══════════════════════════════════════════════════
   EVENT LISTENERS
═══════════════════════════════════════════════════ */
$("btnnew").addEventListener("click", loadNewWord);

$("btnmic").addEventListener("click", () => {
  if (!recognition) return;
  if (listening)  { recognition.stop(); return; }
  if (speaking)   synth.cancel();
  try { recognition.start(); } catch(e) {}
});

$("btnspk").addEventListener("click", () => {
  if (!cur) return;
  speak(`${cur.w}. ${cur.ph}. ${cur.pos}. ${cur.def}. Example: ${cur.ex}`);
});

$("btnhelp").addEventListener("click", () => $("overlay").classList.add("open"));
$("mclose").addEventListener("click",  () => $("overlay").classList.remove("open"));
$("overlay").addEventListener("click", e => { if (e.target === $("overlay")) $("overlay").classList.remove("open"); });

// topic pills
document.querySelectorAll(".tpill").forEach(btn => {
  btn.addEventListener("click", () => {
    document.querySelectorAll(".tpill").forEach(b => b.classList.remove("on"));
    btn.classList.add("on");
    topic = btn.dataset.t;
    buildPool();
    loadNewWord();
  });
});

// quiz input — submit on Enter
$("qinput").addEventListener("keydown", e => {
  if (e.key === "Enter") checkQuizAnswer($("qinput").value);
});

/* ── init ── */
initSR();
updateScore();
setStatus("", "Pick a topic and press 'New word' to begin");
</script>
</body>
</html>
