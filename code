<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>Vocab Tutor — Learn words by voice</title>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.19.0/tabler-icons.min.css"/>
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{
  --s0:#f4f4f2;--s1:#eaeae8;--s2:#fff;
  --tp:#1a1a18;--ts:#6b6b66;--tm:#9a9a94;
  --ta:#185fa5;--tpro:#533db7;--tok:#0f6e56;--terr:#a32d2d;--twrn:#854f0b;
  --bd:rgba(0,0,0,.1);--bds:rgba(0,0,0,.18);
  --bda:#b5d4f4;--bdok:#9fe1cb;--bderr:#f7c1c1;
  --bga:#e6f1fb;--bgpro:#eeedfe;--bgok:#e1f5ee;--bgerr:#fcebeb;--bgwrn:#faeeda;
  --acc:#378add;--on-acc:#fff;
  --rad:8px;--sans:system-ui,-apple-system,sans-serif
}
@media(prefers-color-scheme:dark){:root{
  --s0:#1c1c1a;--s1:#252523;--s2:#2e2e2b;
  --tp:#f0f0ec;--ts:#a8a8a2;--tm:#6b6b66;
  --ta:#85b7eb;--tpro:#afa9ec;--tok:#5dcaa5;--terr:#f09595;--twrn:#ef9f27;
  --bd:rgba(255,255,255,.1);--bds:rgba(255,255,255,.18);
  --bda:#185fa5;--bdok:#0f6e56;--bderr:#993c1d;
  --bga:#0c447c;--bgpro:#3c3489;--bgok:#085041;--bgerr:#791f1f;--bgwrn:#633806;
  --acc:#378add;--on-acc:#fff
}}
body{font-family:var(--sans);background:var(--s0);min-height:100vh;display:flex;align-items:flex-start;justify-content:center;padding:2rem 1rem;color:var(--tp)}
.app{max-width:580px;width:100%}

/* header */
.hdr{text-align:center;margin-bottom:1.75rem}
.hdr h1{font-size:28px;font-weight:500;letter-spacing:-.5px;color:var(--tp)}
.hdr p{font-size:14px;color:var(--ts);margin-top:5px}

/* topic pills */
.topics{display:flex;gap:8px;flex-wrap:wrap;justify-content:center;margin-bottom:1.5rem}
.tpill{padding:6px 15px;border-radius:20px;border:.5px solid var(--bds);background:var(--s2);color:var(--ts);font-size:13px;cursor:pointer;font-family:var(--sans);transition:all .15s}
.tpill:hover{background:var(--s1);color:var(--tp)}
.tpill.on{background:var(--bga);color:var(--ta);border-color:var(--bda)}

/* word card */
.card{background:var(--s2);border:.5px solid var(--bd);border-radius:18px;padding:2rem 1.75rem;text-align:center;margin-bottom:1.25rem;min-height:220px;display:flex;flex-direction:column;align-items:center;justify-content:center;transition:border-color .3s}
.card.flash-ok {border-color:var(--bdok);background:var(--bgok)}
.card.flash-err{border-color:var(--bderr);background:var(--bgerr)}
.clabel{font-size:11px;color:var(--tm);letter-spacing:.6px;font-weight:500;margin-bottom:10px}
.cword{font-size:36px;font-weight:500;letter-spacing:-.5px;color:var(--tp);margin-bottom:6px}
.cphon{font-size:14px;color:var(--ts);font-style:italic;margin-bottom:14px}
.cpos{display:inline-block;padding:3px 11px;border-radius:12px;background:var(--bgpro);color:var(--tpro);font-size:12px;font-weight:500;margin-bottom:14px}
.cdef{font-size:15px;color:var(--ts);line-height:1.65;max-width:430px}
.cex{font-size:13px;color:var(--tm);line-height:1.55;margin-top:12px;font-style:italic;border-left:2px solid var(--bda);padding-left:12px;text-align:left}
.csyns{font-size:12px;color:var(--tm);margin-top:10px}
.cmnem{font-size:13px;color:var(--ts);margin-top:10px;padding:8px 12px;background:var(--s1);border-radius:var(--rad);text-align:left;line-height:1.5}

/* quiz mode overlay on card */
.quiz-prompt{font-size:16px;color:var(--ts);line-height:1.6;margin-bottom:14px}
.quiz-input{width:100%;padding:10px 14px;border-radius:var(--rad);border:.5px solid var(--bds);background:var(--s1);color:var(--tp);font-size:15px;font-family:var(--sans);outline:none;text-align:center}
.quiz-input:focus{border-color:var(--acc)}
.quiz-feedback{font-size:14px;font-weight:500;margin-top:10px}
.quiz-feedback.ok {color:var(--tok)}
.quiz-feedback.err{color:var(--terr)}

/* status */
.sbar{display:flex;align-items:center;gap:10px;margin-bottom:1.25rem;padding:10px 14px;border-radius:var(--rad);background:var(--s1);border:.5px solid var(--bd);min-height:44px}
.sdot{width:8px;height:8px;border-radius:50%;background:var(--bds);flex-shrink:0;transition:background .2s}
.sdot.listen{background:#e24b4a;animation:blink 1.1s infinite}
.sdot.speak {background:var(--acc);animation:blink 1.1s infinite}
.sdot.think {background:#ef9f27;animation:blink 1.1s infinite}
@keyframes blink{0%,100%{opacity:1}50%{opacity:.3}}
.stxt{font-size:13px;color:var(--ts);flex:1}

/* chat log */
.log{background:var(--s1);border-radius:10px;padding:.875rem;margin-bottom:1rem;max-height:140px;overflow-y:auto;display:none;flex-direction:column;gap:8px}
.lmsg{font-size:13px;line-height:1.5}
.lmsg.ag{color:var(--ta)}
.lmsg.us{color:var(--tp)}
.lmsg b{font-weight:500}

/* voice commands hint */
.hints{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:1.25rem}
.hint{font-size:11px;padding:4px 10px;border-radius:12px;background:var(--s1);color:var(--tm);border:.5px solid var(--bd)}

/* controls */
.ctrls{display:flex;gap:10px;margin-bottom:1.25rem}
.btnp{flex:1;padding:12px;border-radius:10px;border:none;background:var(--acc);color:var(--on-acc);font-size:14px;font-weight:500;cursor:pointer;font-family:var(--sans);transition:opacity .15s;display:flex;align-items:center;justify-content:center;gap:8px}
.btnp:hover{opacity:.88}
.btnp:disabled{opacity:.38;cursor:not-allowed}
.btns{padding:12px 16px;border-radius:10px;border:.5px solid var(--bds);background:var(--s2);color:var(--tp);font-size:14px;cursor:pointer;font-family:var(--sans);transition:background .15s}
.btns:hover{background:var(--s1)}

/* progress */
.pgrow{display:flex;align-items:center;gap:10px;margin-bottom:1.25rem}
.pglbl{font-size:12px;color:var(--tm);min-width:70px}
.pgbar{flex:1;height:5px;background:var(--s1);border-radius:3px;overflow:hidden}
.pgfil{height:100%;background:var(--acc);border-radius:3px;transition:width .4s}

/* score chips */
.srow{display:flex;gap:8px;justify-content:center;flex-wrap:wrap;margin-bottom:1.5rem}
.chip{padding:6px 14px;border-radius:20px;font-size:13px;font-weight:500;background:var(--s1);color:var(--ts);border:.5px solid var(--bd)}
.chip.ok {background:var(--bgok);color:var(--tok);border-color:var(--bdok)}
.chip.err{background:var(--bgerr);color:var(--terr);border-color:var(--bderr)}

/* no-speech banner */
.nospeech{padding:.875rem 1rem;background:var(--bgwrn);border-radius:var(--rad);color:var(--twrn);font-size:13px;margin-bottom:1rem;text-align:center;display:none}

/* help modal */
.overlay{position:fixed;inset:0;background:rgba(0,0,0,.45);display:none;align-items:center;justify-content:center;z-index:100;padding:1rem}
.overlay.open{display:flex}
.modal{background:var(--s2);border-radius:16px;padding:1.75rem;max-width:440px;width:100%;border:.5px solid var(--bd)}
.modal h2{font-size:17px;font-weight:500;margin-bottom:1rem}
.modal ul{list-style:none;display:flex;flex-direction:column;gap:8px}
.modal li{font-size:13px;color:var(--ts);line-height:1.5;padding:8px 12px;background:var(--s1);border-radius:var(--rad)}
.modal li b{color:var(--tp);font-weight:500}
.modal-close{margin-top:1.25rem;width:100%;padding:10px;border-radius:var(--rad);border:.5px solid var(--bds);background:transparent;color:var(--tp);font-size:14px;cursor:pointer;font-family:var(--sans)}
.modal-close:hover{background:var(--s1)}

/* shimmer */
.shim{animation:shim 1.4s infinite}
@keyframes shim{0%,100%{opacity:1}50%{opacity:.4}}
</style>
</head>
<body>
<div class="app">

<div class="hdr">
  <h1>Vocab tutor</h1>
  <p>Learn words by voice — no account, no internet needed</p>
</div>

<div class="nospeech" id="nospeech">
  Voice isn't supported in this browser. Try Chrome or Edge for the full experience — or type answers in quiz mode.
</div>

<div class="topics" id="topics">
  <button class="tpill on" data-t="all">All</button>
  <button class="tpill" data-t="academic">Academic</button>
  <button class="tpill" data-t="business">Business</button>
  <button class="tpill" data-t="literary">Literary</button>
  <button class="tpill" data-t="science">Science</button>
  <button class="tpill" data-t="everyday">Everyday</button>
</div>

<div class="card" id="card">
  <div class="clabel">tap "new word" to start</div>
  <div class="cword shim" id="cword">—</div>
  <div class="cphon" id="cphon"></div>
  <div class="cpos" id="cpos" style="display:none"></div>
  <div class="cdef" id="cdef">Pick a topic and press "New word" to begin.</div>
  <div class="cex"  id="cex"  style="display:none"></div>
  <div class="csyns" id="csyns" style="display:none"></div>
  <div class="cmnem" id="cmnem" style="display:none"></div>
</div>

<!-- quiz overlay inside card (shown programmatically) -->
<div id="quiz-area" style="display:none;width:100%">
  <div class="card" id="quiz-card" style="min-height:180px">
    <div class="clabel">quiz time</div>
    <div class="quiz-prompt" id="qprompt"></div>
    <input class="quiz-input" id="qinput" type="text" placeholder="Type your answer…" autocomplete="off"/>
    <div class="quiz-feedback" id="qfb"></div>
  </div>
</div>

<div class="sbar">
  <div class="sdot" id="sdot"></div>
  <div class="stxt" id="stxt">Ready</div>
</div>

<div class="log" id="log"></div>

<div class="hints" id="hints" style="display:none">
  <span class="hint">say "quiz me"</span>
  <span class="hint">say "example"</span>
  <span class="hint">say "synonyms"</span>
  <span class="hint">say "memory tip"</span>
  <span class="hint">say "repeat"</span>
  <span class="hint">say "next word"</span>
</div>

<div class="ctrls">
  <button class="btnp" id="btnmic" disabled>
    <i class="ti ti-microphone"></i> Ask something
  </button>
  <button class="btns" id="btnnew">New word</button>
  <button class="btns" id="btnspk" style="display:none" title="Repeat word">
    <i class="ti ti-volume"></i>
  </button>
  <button class="btns" id="btnhelp" title="Voice commands">
    <i class="ti ti-help"></i>
  </button>
</div>

<div class="pgrow">
  <div class="pglbl" id="pglbl">0% correct</div>
  <div class="pgbar"><div class="pgfil" id="pgfil" style="width:0%"></div></div>
</div>

<div class="srow">
  <div class="chip ok"  id="cok">✓ 0 correct</div>
  <div class="chip err" id="cerr">✗ 0 wrong</div>
  <div class="chip"     id="cstr">🔥 0 streak</div>
  <div class="chip"     id="ctot">📚 0 seen</div>
</div>

</div><!-- /app -->

<!-- help modal -->
<div class="overlay" id="overlay">
  <div class="modal">
    <h2>Voice commands</h2>
    <ul>
      <li><b>"New word"</b> — fetch the next vocabulary word</li>
      <li><b>"Quiz me"</b> — test yourself on the current word</li>
      <li><b>"Give me an example"</b> — hear another example sentence</li>
      <li><b>"Synonyms"</b> — hear related words</li>
      <li><b>"Memory tip"</b> — get a mnemonic to remember the word</li>
      <li><b>"Repeat"</b> — hear the word and definition again</li>
      <li><b>"What does it mean?"</b> — hear the definition</li>
      <li><b>"How do you spell it?"</b> — hear the spelling</li>
      <li><b>"Next word"</b> — skip to a new word</li>
    </ul>
    <button class="modal-close" id="mclose">Got it</button>
  </div>
</div>

<script>
/* ═══════════════════════════════════════════════════
   VOCABULARY BANK  — 120 words across 6 topics
   Zero API calls. Fully offline.
═══════════════════════════════════════════════════ */
const WORDS = [
/* ACADEMIC */
{t:"academic",w:"Ephemeral",ph:"/ɪˈfem.ər.əl/",pos:"adjective",def:"Lasting for a very short time; transitory.",ex:"The cherry blossoms are ephemeral, fading within days of blooming.",syns:"fleeting, transient, momentary",mem:"'E-fem-eral' — think of a female butterfly, alive for just one brief season."},
{t:"academic",w:"Ubiquitous",ph:"/juːˈbɪk.wɪ.təs/",pos:"adjective",def:"Present, appearing, or found everywhere.",ex:"Smartphones have become ubiquitous in modern society.",syns:"omnipresent, pervasive, universal",mem:"'You-bick-witous' — YOU can't escape it, it's everywhere!"},
{t:"academic",w:"Pragmatic",ph:"/præɡˈmæt.ɪk/",pos:"adjective",def:"Dealing with things sensibly and realistically, rather than theoretically.",ex:"We need a pragmatic solution, not an idealistic one.",syns:"practical, realistic, sensible",mem:"A PRAGMATIC person always asks: will this actually work in PRACTICE?"},
{t:"academic",w:"Ambiguous",ph:"/æmˈbɪɡ.ju.əs/",pos:"adjective",def:"Open to more than one interpretation; not clear or decided.",ex:"The contract contained several ambiguous clauses that led to disputes.",syns:"vague, unclear, equivocal",mem:"AMBIguous — it could go THIS way OR THAT way, like an ambi-dextrous person."},
{t:"academic",w:"Paradigm",ph:"/ˈpær.ə.daɪm/",pos:"noun",def:"A typical example or pattern of something; a model or framework.",ex:"The discovery of DNA was a paradigm shift in biology.",syns:"model, framework, archetype",mem:"PARA-DIME — picture a pair of dimes as the perfect example of a coin."},
{t:"academic",w:"Empirical",ph:"/ɪmˈpɪr.ɪ.kəl/",pos:"adjective",def:"Based on observation or experience rather than theory or logic.",ex:"The scientist demanded empirical evidence before accepting the hypothesis.",syns:"observational, experiential, verifiable",mem:"EMPIRE of facts — an emperor only trusts what he can see with his own eyes."},
{t:"academic",w:"Synthesis",ph:"/ˈsɪn.θɪ.sɪs/",pos:"noun",def:"The combination of ideas to form a new theory or system.",ex:"Her thesis was a synthesis of economics and psychology.",syns:"combination, integration, fusion",mem:"SYNthesis — SYN means together, like synchronise. Bringing things together."},
{t:"academic",w:"Didactic",ph:"/daɪˈdæk.tɪk/",pos:"adjective",def:"Intended to teach, particularly in a moralistic way.",ex:"The novel has a didactic tone, constantly moralising about virtue.",syns:"instructive, educational, preachy",mem:"DID-ACT-IC — the teacher DID ACT to teach you something."},
{t:"academic",w:"Nuanced",ph:"/ˈnjuː.ɑːnst/",pos:"adjective",def:"Characterised by subtle distinctions or variations; finely detailed.",ex:"Her nuanced analysis captured complexity others had overlooked.",syns:"subtle, refined, delicate",mem:"NEW-anced — a NEW shade of meaning, very subtle."},
{t:"academic",w:"Dichotomy",ph:"/daɪˈkɒt.ə.mi/",pos:"noun",def:"A division into two contrasting groups or sets of opinions.",ex:"There is a false dichotomy between tradition and innovation.",syns:"division, split, contrast",mem:"DI-CHOTOMY — DI means two, like bicycle. A split into two."},
{t:"academic",w:"Pedagogy",ph:"/ˈped.ə.ɡɒ.dʒi/",pos:"noun",def:"The art, science, or profession of teaching.",ex:"Modern pedagogy emphasises active learning over passive memorisation.",syns:"teaching, instruction, education",mem:"PEDA-GOGY — think of a PEDESTRIAN going step-by-step to guide students."},
{t:"academic",w:"Esoteric",ph:"/ˌes.əˈter.ɪk/",pos:"adjective",def:"Intended for or understood by only a small group of specialists.",ex:"The professor's research was too esoteric for the general public.",syns:"obscure, arcane, abstruse",mem:"ESO-TERIC — only the INNER circle understands it (inward = eso)."},
{t:"academic",w:"Rhetoric",ph:"/ˈret.ər.ɪk/",pos:"noun",def:"Persuasive language, especially used in public speaking or writing.",ex:"His speech was full of rhetoric but lacked concrete policy.",syns:"oratory, eloquence, persuasion",mem:"RHETO-RIC — think of a RHET-ORICAL question: it sounds good but means little."},
{t:"academic",w:"Cognition",ph:"/kɒɡˈnɪʃ.ən/",pos:"noun",def:"The mental process of acquiring knowledge through thought and experience.",ex:"Sleep is essential for healthy cognition and memory consolidation.",syns:"thinking, perception, understanding",mem:"COG-NITION — a COG in the brain machine, turning thoughts into knowledge."},
{t:"academic",w:"Axiom",ph:"/ˈæk.si.əm/",pos:"noun",def:"A statement regarded as self-evidently true, used as a starting point.",ex:"'All men are mortal' is a classic axiom of logic.",syns:"principle, truth, maxim",mem:"AX-IOM — an AXE is obviously sharp; an axiom is obviously true."},
/* BUSINESS */
{t:"business",w:"Leverage",ph:"/ˈlev.ər.ɪdʒ/",pos:"noun",def:"The use of borrowed capital or strategic advantage to increase potential return.",ex:"The startup used its brand leverage to secure a better deal.",syns:"influence, power, advantage",mem:"A LEVER-age gives you mechanical advantage — use a small force, get a big result."},
{t:"business",w:"Synergy",ph:"/ˈsɪn.ər.dʒi/",pos:"noun",def:"The combined effect of two entities working together that exceeds their individual effects.",ex:"The merger created synergy that reduced costs for both companies.",syns:"cooperation, collaboration, combined effect",mem:"SYN-ERGY — SYN means together; ENERGY combined is greater than separate."},
{t:"business",w:"Scalable",ph:"/ˈskeɪ.lə.bəl/",pos:"adjective",def:"Capable of being changed in size or scale; able to grow without proportional cost increase.",ex:"They built a scalable cloud infrastructure that handled ten times the traffic.",syns:"expandable, adaptable, flexible",mem:"SCALE-able — you can tip the SCALES up or down without breaking the system."},
{t:"business",w:"Pivot",ph:"/ˈpɪv.ɪt/",pos:"verb",def:"To change a company's direction or strategy in response to market feedback.",ex:"After poor sales, they pivoted from B2C to a B2B model.",syns:"shift, redirect, reorient",mem:"Like a basketball player PIVOTING on one foot to face a new direction."},
{t:"business",w:"Due diligence",ph:"/djuː ˈdɪl.ɪ.dʒəns/",pos:"noun",def:"Thorough investigation and research done before signing an agreement or making a decision.",ex:"Investors conducted three months of due diligence before acquiring the firm.",syns:"research, investigation, scrutiny",mem:"DUE DILIGENCE — it's your DUTY to be DILIGENT before you commit."},
{t:"business",w:"Disruptive",ph:"/dɪsˈrʌp.tɪv/",pos:"adjective",def:"Causing radical change to an existing industry or market through innovation.",ex:"Uber's disruptive model challenged the traditional taxi industry.",syns:"revolutionary, innovative, transformative",mem:"DIS-RUPTIVE — it RUPTURES (breaks apart) the old way of doing things."},
{t:"business",w:"Equity",ph:"/ˈek.wɪ.ti/",pos:"noun",def:"The value of shares issued by a company; or ownership interest after debts are paid.",ex:"She negotiated for 5% equity instead of a higher salary.",syns:"ownership, stake, shares",mem:"EQU-ITY — EQUAL share; equity means your equal piece of the pie."},
{t:"business",w:"Iterate",ph:"/ˈɪt.ər.eɪt/",pos:"verb",def:"To repeat a process in order to generate a sequence of improving outcomes.",ex:"The design team iterated on the prototype weekly based on user feedback.",syns:"refine, repeat, improve",mem:"IT-ER-ATE — IT goes around and around, each time getting better."},
{t:"business",w:"Benchmark",ph:"/ˈbentʃ.mɑːk/",pos:"noun",def:"A standard point of reference used for comparison or measurement.",ex:"The new product exceeded the industry benchmark for energy efficiency.",syns:"standard, measure, reference point",mem:"A surveyor's BENCH MARK was a notch cut into stone as a reference point for measurements."},
{t:"business",w:"Agile",ph:"/ˈædʒ.aɪl/",pos:"adjective",def:"Relating to an iterative approach to project management and software development.",ex:"The agile team delivered working software in two-week sprints.",syns:"flexible, adaptive, nimble",mem:"AGILE — like a gymnast, quick to change direction and adapt to new demands."},
{t:"business",w:"Runway",ph:"/ˈrʌn.weɪ/",pos:"noun",def:"The length of time a startup can operate before running out of funding.",ex:"With the new investment, the company extended its runway to 18 months.",syns:"operating period, cash reserve, timeframe",mem:"Like a plane on a RUNWAY — you need enough space to gain speed before takeoff or you crash."},
{t:"business",w:"Churn",ph:"/tʃɜːn/",pos:"noun",def:"The rate at which customers stop using a product or service.",ex:"High churn signalled that the app wasn't solving a real problem.",syns:"attrition, dropout rate, turnover",mem:"Like CHURNING butter — customers who leave are 'churned out' of your base."},
{t:"business",w:"Traction",ph:"/ˈtræk.ʃən/",pos:"noun",def:"Early evidence of market adoption and momentum for a product or startup.",ex:"The app gained traction quickly, hitting 10,000 users in the first month.",syns:"momentum, adoption, progress",mem:"TRACTION — like tyres gripping the road; your business is getting a grip on the market."},
{t:"business",w:"Stakeholder",ph:"/ˈsteɪk.həʊl.dər/",pos:"noun",def:"A person with an interest or concern in a business or project.",ex:"All stakeholders were invited to the product roadmap review.",syns:"interested party, shareholder, participant",mem:"Someone who holds a STAKE in the outcome — like a gambler with money on the table."},
{t:"business",w:"ROI",ph:"/ɑːr.əʊˈaɪ/",pos:"noun",def:"Return on Investment; the benefit gained relative to cost.",ex:"The marketing campaign delivered an ROI of 300% in six months.",syns:"return, profit, yield",mem:"ROI — did you get your money back, and then some? That's your Return On Investment."},
/* LITERARY */
{t:"literary",w:"Melancholy",ph:"/ˈmel.ən.kɒl.i/",pos:"noun",def:"A feeling of pensive sadness, typically with no obvious cause.",ex:"A deep melancholy settled over him as autumn faded into winter.",syns:"sadness, gloom, sorrow",mem:"MEL-AN-CHOLY — think of a melancholic melody that makes you feel wistfully sad."},
{t:"literary",w:"Solitude",ph:"/ˈsɒl.ɪ.tjuːd/",pos:"noun",def:"The state of being alone, often experienced as peaceful rather than lonely.",ex:"She retreated to the mountains to enjoy complete solitude.",syns:"seclusion, isolation, aloneness",mem:"SOL-ITUDE — SOLO + attitude; choosing to be alone with a peaceful state of mind."},
